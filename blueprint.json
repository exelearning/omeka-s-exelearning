{
  "$schema": "https://omeka-s-contrib.github.io/omeka-s-blueprints/schema/v0/blueprint-schema.json",
  "install": {
    "title": "eXeLearning Playground",
    "locale": "es",
    "timezone": "Atlantic/Canary"
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "password": "password",
      "role": "global_admin"
    },
    {
      "username": "editor",
      "email": "editor@example.com",
      "password": "1234",
      "role": "editor"
    }
  ],
  "modules": [
    {
      "name": "ExeLearning",
      "state": "activate",
      "source": "https://github.com/exelearning/omeka-s-exelearning/archive/refs/heads/main.zip"
    }
  ],
  "files": [
    {
      "source": "https://github.com/exelearning/exelearning/releases/download/v4.0.5/exelearning-static-v4.0.5.zip",
      "destination": "modules/ExeLearning/dist/static",
      "extract": true
    }
  ],
  "itemSets": [
    {
      "title": "eXeLearning Samples",
      "description": "eXeLearning content ready to test the module in Omeka S Playground."
    }
  ],
  "items": [
    {
      "title": "Really Simple Test Project",
      "description": "Minimal eXeLearning project to validate viewing and editing of .elpx files.",
      "creator": "eXeLearning",
      "itemSets": [
        "eXeLearning Samples"
      ],
      "media": [
        {
          "type": "url",
          "url": "https://raw.githubusercontent.com/exelearning/omeka-s-exelearning/refs/heads/main/data/fixtures/really-simple-test-project.elpx",
          "title": "really-simple-test-project.elpx"
        }
      ]
    }
  ],
  "sites": [
    {
      "title": "eXeLearning Demo",
      "slug": "demo",
      "theme": "default",
      "summary": "Minimal setup to test the eXeLearning module in Omeka S Playground.",
      "isPublic": true,
      "setAsDefault": true
    }
  ],
  "x-playground": {
    "debug": {
      "enabled": true
    },
    "landingPage": "/admin"
  }
}
