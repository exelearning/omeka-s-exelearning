<?php
/**
 * Admin media show partial.
 *
 * The viewer itself is rendered by ExeLearningRenderer through
 * $media->render(), which core's admin media page calls before triggering
 * view.show.after. The renderer also carries the edit button and loads the
 * editor modal script, so the same button works on public pages. This partial
 * carries only what is specific to this admin page: the processing error and
 * the download filename fix-up for core's File Derivatives links.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\MediaRepresentation $media
 * @var string|null $processingError Why the last extraction attempt failed.
 */
?>

<?php if (!empty($processingError)): ?>
<div class="exelearning-process-error error">
    <p>
        <?= $this->escapeHtml($this->translate('This eXeLearning package could not be processed, so no preview is available.')) ?>
    </p>
    <p><code><?= $this->escapeHtml($processingError) ?></code></p>
    <p>
        <?= $this->escapeHtml($this->translate('Fix the cause, then save this media to try again.')) ?>
    </p>
</div>
<?php endif; ?>

<script>
// Add download attribute with original filename to File Derivatives links
(function() {
    var source = <?= json_encode($media->source(), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    if (!source) return;
    document.querySelectorAll('.meta-group a[href*="/files/original/"]').forEach(function(link) {
        link.setAttribute('download', source);
    });
})();
</script>
